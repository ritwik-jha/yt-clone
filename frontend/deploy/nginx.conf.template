# Rendered by the nginx image's entrypoint (envsubst) into
# /etc/nginx/conf.d/default.conf. ${API_ORIGIN}, ${API_HOST} and
# ${NGINX_LOCAL_RESOLVERS} come from the environment; every other $var is
# nginx's own.
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;
    client_max_body_size 1m;

    # Re-resolve the API's ALB: its IPs change, and a variable in proxy_pass
    # makes nginx look the name up per request (cached for 30s) instead of
    # once at start.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=30s ipv6=off;

    # Container health check for Express Mode's target group. /healthz is
    # the API's own and is proxied below.
    location = /_health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # The API. Matches /auth/..., /video/..., /upload/... (the app's own
    # /upload page has no trailing path, so it stays with the app) and
    # /healthz.
    location ~ ^/((auth|video|upload)/|healthz$) {
        set $api_origin ${API_ORIGIN};
        proxy_pass $api_origin;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        # Express Mode's ALB routes on the Host header.
        proxy_set_header Host ${API_HOST};
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_ssl_server_name on;
        proxy_ssl_name ${API_HOST};
        proxy_ssl_verify on;
        proxy_ssl_verify_depth 3;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }

    # The app. Real paths (/watch?v=..., /channel/...) fall back to
    # index.html so reloads and shared links work. Nothing in the Flutter
    # build is content-hashed, so everything revalidates (ETag) on each load.
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    }

    gzip on;
    gzip_types text/css application/javascript application/json application/wasm image/svg+xml;
    gzip_min_length 1024;
}
