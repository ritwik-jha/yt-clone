# Copy to .env and fill in values. Loaded by app/config.py at process start.

# --- App ---
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
ACCESS_COOKIE_MAX_AGE=3600
REFRESH_COOKIE_MAX_AGE=432000
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# --- AWS ---
AWS_REGION=ap-south-1

# --- Cognito ---
COGNITO_USER_POOL_ID=ap-south-1_XXXXXXXXX
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
COGNITO_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- DynamoDB (match terraform outputs `dynamodb_table`, `dynamodb_users_table`) ---
DDB_VIDEOS_TABLE=video-status
DDB_USERS_TABLE=users

# --- S3 buckets ---
S3_RAW_VIDEOS_BUCKET=my-org-raw-videos
S3_THUMBNAILS_BUCKET=my-org-thumbnails
PRESIGNED_URL_TTL_SECONDS=3600

# --- SQS completion queue (terraform output: completion_queue_url) ---
COMPLETION_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/123456789012/video-completion-queue
COMPLETION_POLL_WAIT_SECONDS=10
COMPLETION_MAX_MESSAGES=10

# --- Redis (terraform output: redis_endpoint) ---
REDIS_HOST=video-progress-cache-xxxxxx.serverless.aps1.cache.amazonaws.com
REDIS_PORT=6379
REDIS_TLS=1
REDIS_PROGRESS_PREFIX=video:progress
