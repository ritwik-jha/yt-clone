# Reference for every setting app/config.py reads, and the fallback source
# for values Terraform does not own.
#
# Local development only — the ECS services get their environment from
# backend/terraform/ecs.tf. Run `scripts/generate-env.sh` to fill the
# infrastructure values from Terraform state, or copy this file by hand.
#
# Adding a setting? Add it to config.py, here, the emit block in
# scripts/generate-env.sh, AND the matching environment map in
# backend/terraform/ecs.tf.

# --- App ---
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
ACCESS_COOKIE_MAX_AGE=3600
REFRESH_COOKIE_MAX_AGE=432000
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# --- AWS ---
AWS_REGION=ap-south-1

# --- Cognito (terraform outputs: cognito_user_pool_id / cognito_user_pool_client_id / cognito_user_pool_client_secret) ---
COGNITO_USER_POOL_ID=ap-south-1_XXXXXXXXX
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
COGNITO_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- PostgreSQL ---
# RDS is private to the VPC, so local runs use the postgres service in
# docker-compose.yml (which overrides DB_HOST and DB_SSLMODE for its
# containers). On ECS, DB_* comes from terraform/ecs.tf and the password is
# read from the RDS-managed secret named by DB_SECRET_ARN; never set
# DB_PASSWORD there.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=videoapp
DB_USER=videoapp
DB_PASSWORD=videoapp-local
DB_SECRET_ARN=
DB_SSLMODE=disable
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# --- S3 buckets ---
S3_RAW_VIDEOS_BUCKET=my-org-raw-videos
S3_THUMBNAILS_BUCKET=my-org-thumbnails
# Pipeline output processed_bucket. Only DELETE /video/{id} uses it.
S3_PROCESSED_BUCKET=my-org-processed-videos
PRESIGNED_URL_TTL_SECONDS=3600

# --- SQS completion queue (terraform output: completion_queue_url) ---
COMPLETION_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/123456789012/video-completion-queue
COMPLETION_POLL_WAIT_SECONDS=10
COMPLETION_MAX_MESSAGES=10

# --- Redis (terraform output: redis_endpoint) ---
# docker-compose.yml points its containers at a local Redis instead.
REDIS_HOST=video-progress-cache-xxxxxx.serverless.aps1.cache.amazonaws.com
REDIS_PORT=6379
REDIS_TLS=1
REDIS_PROGRESS_PREFIX=video:progress
REDIS_META_PREFIX=video:meta
VIDEO_META_CACHE_TTL_SECONDS=3600

# --- CloudFront (playback: pipeline output cloudfront_domain_name;
#     thumbnails: backend output thumbnails_cdn_domain) ---
CLOUDFRONT_DOMAIN=dxxxxxxxxxxxxx.cloudfront.net
THUMBNAILS_CDN_DOMAIN=dyyyyyyyyyyyyy.cloudfront.net
