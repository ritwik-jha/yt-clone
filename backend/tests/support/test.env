# Settings for the backend under test (SQLite + fake AWS clients). Values
# for AWS resources only need to be non-empty: tests/support/server.py
# replaces every client that would use them.
DATABASE_URL=sqlite:///./test.db
COGNITO_USER_POOL_ID=test-pool
COGNITO_CLIENT_ID=test-client
COGNITO_CLIENT_SECRET=test-secret
S3_RAW_VIDEOS_BUCKET=test-raw
S3_THUMBNAILS_BUCKET=test-thumbnails
S3_PROCESSED_BUCKET=test-processed
REDIS_HOST=fake-redis
# Playback URLs are /media/<key> on this server (server.py checks the cookies).
MEDIA_BASE_URL=/media
THUMBNAILS_CDN_DOMAIN=thumbs.test
# Presigned uploads go to the test server's in-memory buckets (server.py).
FAKE_S3_URL=http://127.0.0.1:8000/_s3
# Plain-http localhost: cookies must not be Secure or the browser drops them.
COOKIE_SECURE=false
CORS_ORIGINS=http://127.0.0.1:8090,http://localhost:8090
