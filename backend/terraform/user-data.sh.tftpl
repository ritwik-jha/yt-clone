#!/usr/bin/env bash
#
# Instance bootstrap. Installs Docker and the AWS CLI, drops the compose
# file, deploy script, and systemd unit onto the box, then starts the unit.
#
# Everything application-shaped lives in the files copied below, not here —
# re-running `backend/scripts/deploy.sh` is how you redeploy, and the
# instance never needs to be rebuilt for a code or config change.

set -euxo pipefail

export DEBIAN_FRONTEND=noninteractive

apt-get update
apt-get install -y --no-install-recommends ca-certificates curl unzip

# --- Docker CE + compose v2 plugin ---------------------------------------
# Ubuntu's docker.io package has no compose v2 plugin, so use Docker's repo.

install -m 0755 -d /etc/apt/keyrings
curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc
chmod a+r /etc/apt/keyrings/docker.asc

echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu $(. /etc/os-release && echo "$VERSION_CODENAME") stable" \
  >/etc/apt/sources.list.d/docker.list

apt-get update
apt-get install -y docker-ce docker-ce-cli containerd.io docker-compose-plugin
systemctl enable --now docker

# --- AWS CLI v2 ----------------------------------------------------------
# uname -m already reports the names AWS uses (aarch64 / x86_64).

curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-$(uname -m).zip" -o /tmp/awscliv2.zip
unzip -q /tmp/awscliv2.zip -d /tmp
/tmp/aws/install --update
rm -rf /tmp/awscliv2.zip /tmp/aws

# --- Application files ---------------------------------------------------

install -d -m 755 /opt/video-backend /etc/video-backend

echo '${compose_b64}' | base64 -d >/opt/video-backend/docker-compose.yml
echo '${deploy_b64}'  | base64 -d >/opt/video-backend/deploy.sh
echo '${unit_b64}'    | base64 -d >/etc/systemd/system/video-backend.service
chmod 755 /opt/video-backend/deploy.sh

cat >/etc/video-backend/deploy.conf <<'CONF'
AWS_REGION=${aws_region}
ENV_PARAM=${env_param}
BACKEND_IMAGE=${backend_image}
ECR_REGISTRY=${ecr_registry}
LOG_GROUP=${log_group}
API_BIND=0.0.0.0
CONF
chmod 644 /etc/video-backend/deploy.conf

# --- Start ---------------------------------------------------------------
# The unit fails and retries every 30s until the .env has been pushed to SSM
# and an image exists in ECR, so ordering between this boot and the operator's
# first push does not matter.

systemctl daemon-reload
systemctl enable --now video-backend.service
