# Copy to terraform.tfvars and fill in. Apply only after IAC/terraform.

# Must match the pipeline stack, or the check block fails the plan.
aws_region   = "ap-south-1"
project_name = "video-transcoder"
backend_name = "video-backend"

# Where this stack reads the pipeline outputs from.
# For a remote pipeline state, set pipeline_state_backend = "s3" and fill in
# pipeline_state_s3_bucket / pipeline_state_s3_key instead.
pipeline_state_backend    = "local"
pipeline_state_local_path = "../../IAC/terraform/terraform.tfstate"

# REQUIRED. The Cognito user pool is not created by any stack in this repo —
# provision it first, with a client secret and USER_PASSWORD_AUTH enabled.
cognito_user_pool_arn = "arn:aws:cognito-idp:ap-south-1:123456789012:userpool/ap-south-1_XXXXXXXXX"

# REQUIRED. Globally unique across all of S3.
thumbnails_bucket_name  = "my-org-thumbnails"
thumbnails_cors_origins = ["https://app.example.com"]

# Container image. t4g.* instance types need cpu_architecture = "arm64".
ecr_repository_name = "video-backend"
image_tag           = "latest"
instance_type       = "t4g.small"
cpu_architecture    = "arm64"

root_volume_size_gb = 30
associate_eip       = true

# Empty means no inbound rule at all: reach the box over SSM Session Manager.
# Open the API port only to your ALB's SG or to a known admin CIDR.
api_ingress_cidrs = []
ssh_ingress_cidrs = []

# Set to use SSH instead of Session Manager; leave unset otherwise.
# key_pair_name = "my-keypair"

log_retention_days = 30

tags = {
  Environment = "dev"
  Owner       = "video-platform"
}
